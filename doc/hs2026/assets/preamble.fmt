%format TmInf       = "\Varid{Tm}_{\uparrow}"
%format TmChk       = "\Varid{Tm}_{\downarrow}"
%format |>          = "\triangleright"
%format :>          = "\mathbin{{:}\triangleright}"
%format :->         = "\mathbin{{:}\mkern-5mu\rightarrow}"
%format :@:         = "\mathbin{{:}@{:}}"
%format γ           = "\gamma"
%format τ           = "\tau"
%format τ'          = "\tau^{\prime}"
